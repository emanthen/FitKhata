# Copy to infra/.env on the server (chmod 600, never commit it).
# docker-compose.yml reads this automatically; deploy.yml sources it too.

# --- Domains / TLS -----------------------------------------------------------
DOMAIN_APP=app.fitkhata.com
DOMAIN_API=api.fitkhata.com
DOMAIN_STATUS=status.fitkhata.com
CADDY_EMAIL=admin@fitkhata.com
# htpasswd-style "user hash" for the status page, bcrypt hash only (escape $ as $$):
# generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext '...'
STATUS_BASIC_AUTH=admin $$2a$$14$$replace-with-real-bcrypt-hash

# --- Images (set by deploy.yml at deploy time; harmless defaults here) ------
API_IMAGE=ghcr.io/OWNER/REPO/api
WEB_IMAGE=ghcr.io/OWNER/REPO/web
IMAGE_TAG=latest

# --- Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-value
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key   # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SENTRY_DSN=

# --- Postgres -------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
FITKHATA_APP_PASSWORD=replace-with-a-strong-password
FITKHATA_SYSTEM_PASSWORD=replace-with-a-strong-password

# --- Cloudflare R2 (app file storage + WAL-G backups) ---------------------------
# No local object store: MinIO's open-source edition was archived upstream in
# 2026. The app writes files directly to R2 (django-storages, S3-compatible
# API) and WAL-G ships Postgres backups to it — use separate buckets for each.
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_STORAGE_BUCKET=fitkhata-media
WALG_S3_PREFIX=s3://fitkhata-backups/wal
BACKUP_HOUR_UTC=2
